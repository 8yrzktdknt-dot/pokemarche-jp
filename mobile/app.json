{
  "expo": {
    "name": "TCGMarket",
    "slug": "pokemarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokemarket.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner vos cartes pour les identifier."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A7D4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pokemarket.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "TCGMarket",
      "shortName": "TCGMarket",
      "themeColor": "#0A1F17",
      "backgroundColor": "#0A1F17",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner vos cartes pour les identifier.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "pokemarket",
    "backgroundColor": "#0A1F17",
    "experiments": {
      "baseUrl": "/tcgmarket/app"
    }
  }
}
